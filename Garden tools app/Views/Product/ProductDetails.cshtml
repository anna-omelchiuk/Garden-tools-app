@model Garden_tools_app.Models.Product

@{
    ViewData["Title"] = Model?.Name;
    var products = ViewBag.Products as List<Garden_tools_app.Models.Product>;
    var cart = ViewBag.Cart as List<Garden_tools_app.Models.Product>;
    var reviews = ViewBag.Reviews as List<string>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <h4>Каталог</h4>
            <div class="list-group">
                @foreach (var p in products)
                {
                    string active = p.Id == Model?.Id ? "active" : "";
                    <a href="/Product/Details?id=@p.Id" class="list-group-item list-group-item-action @active">@p.Name</a>
                }
            </div>
        </div>
        <div class="col-md-5">
            @if (Model != null)
            {
                <h2>@Model.Name</h2>
                <p class="text-muted">Категорія: @Model.Category</p>
                <h3 class="text-success">@Model.Price.ToString("C")</h3>
                <p><strong>Опис:</strong> @Model.Description</p>
                
                <form asp-action="AddToCart" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Додати у кошик</button>
                </form>
            }
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light border rounded">
                <h4>Кошик</h4>
                @if (cart.Count == 0)
                {
                    <p class="text-muted">Кошик порожній</p>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var item in cart)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Name (@item.Price.ToString("C"))
                                <form asp-action="RemoveFromCart" method="post" style="margin:0;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="currentId" value="@Model?.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Х</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <h5>Сума: <span class="text-success">@cart.Sum(x => x.Price).ToString("C")</span></h5>
                }
            </div>
        </div>
    </div>
</div>

@section reviews {
    <div class="container mt-4">
        <div class="p-4 bg-light border rounded">
            <h4>Відгуки</h4>
            <form asp-action="AddReview" method="post" class="mb-3">
                <input type="hidden" name="id" value="@Model?.Id" />
                <div class="mb-2">
                    <textarea name="reviewText" class="form-control" placeholder="Ваш відгук..." required></textarea>
                </div>
                <button type="submit" class="btn btn-success btn-sm">Надіслати</button>
            </form>
            <hr />
            @foreach (var rev in reviews)
            {
                <p class="border-start border-primary ps-2">@rev</p>
            }
        </div>
    </div>
}